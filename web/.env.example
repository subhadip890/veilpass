# VeilPass Frontend - Public environment placeholders
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or any file containing secrets.

# Midnight Network to connect (must be "preprod" for Level 2)
VITE_MIDNIGHT_NETWORK=preprod

# Preprod contract address (set after deployment)
VITE_CONTRACT_ADDRESS=

# Preprod indexer GraphQL endpoint
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql

# Preprod indexer WebSocket endpoint
VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Proof server (local Docker or remote)
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300
